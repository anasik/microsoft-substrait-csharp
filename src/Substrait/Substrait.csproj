<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <AssemblyName>Microsoft.Substrait</AssemblyName>
    <RootNamespace>Substrait</RootNamespace>
    <IsPackable>true</IsPackable>
    <PackageId>Microsoft.Substrait</PackageId>
    <VersionPrefix>0.1.0</VersionPrefix>
    <Description>A library for creating, modifying, serializing, and processing Substrait plans in .NET.</Description>
    <PackageTags>Substrait;protobuf;query-plan</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.SourceLink.GitHub" PrivateAssets="All" />
  </ItemGroup>

  <ItemGroup>
    <None Include="$(RepositoryRoot)README.md" Pack="true" PackagePath="\" />
  </ItemGroup>
</Project>